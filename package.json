{
  "name": "survivor-pool",
  "packageManager": "bun@1.4.3",
  "type": "module",
  "scripts": {
    "db": "docker compose up -d && bun drizzle",
    "dev": "rm -f public/client-*.js && ENVIRONMENT=development bun --hot ./src/server.tsx",
    "dev:authed": "rm -f public/client-*.js && ENVIRONMENT=development MOCK_AUTH=true bun --hot ./src/server.tsx",
    "drizzle": "drizzle-kit push",
    "docker": "docker build . --tag survivor-pool",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint . --fix --max-warnings=0",
    "start": "bun ./src/server.tsx",
    "tailwind": "tailwindcss -o ./public/globals.css",
    "test-backend": "POSTGRES_URL=postgresql://postgres:pwd@localhost:5433/survivor-pool-test bun test test/**",
    "test-frontend": "bunx cypress run --component"
  },
  "dependencies": {
    "@clerk/backend": "3.23.2",
    "@clerk/clerk-react": "5.61.3",
    "@headlessui/react": "2.2.10",
    "@heroicons/react": "2.2.0",
    "@tailwindcss/cli": "4.3.3",
    "@tanstack/react-query": "5.104.1",
    "@trpc/client": "11.19.0",
    "@trpc/react-query": "11.19.0",
    "@trpc/server": "11.19.0",
    "drizzle-orm": "0.45.4",
    "isbot": "5.2.2",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "6.1.6",
    "react-router-dom": "7.18.4",
    "spacetime": "7.16.0",
    "tailwindcss": "4.3.3",
    "trpc-bun-adapter": "1.3.2",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@testing-library/cypress": "10.1.3",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cypress": "16.1.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
